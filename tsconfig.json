{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "~/*": ["./*"],
      "~~/*": ["./*"],
      "#imports": ["./.nuxt/imports"],
      "#db/*": ["./database/*"],
      "#utils/*": ["./server/utils/*"],
      "#services/*": ["./server/services/*"]
    }
  },
  "include": [
    "server/**/*",
    "database/**/*",
    "scripts/**/*",
    "tests/**/*",
    "nuxt.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".output", "dist"]
}
