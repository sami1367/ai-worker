# GitHub projects for the AI worker.
# Copy to github-projects.conf and edit:
#   cp github-projects.conf.example github-projects.conf
#
# Format: JSON array of objects.
# Required fields: name, path
# Optional fields:
#   block_on_open_pr — if true (default), do not start a new `ai` issue
#                      while this repo has an open PR labeled ai,
#                      ai-working, ai-failed, or ai-pr. Human PRs without
#                      those labels do not block. Set false to allow new
#                      issues even with AI-labeled open PRs.
#                      (ai-working issues and a running agent still block.)
#   default_branch — PR/MR target branch (default main).
#   force_push_to_default — if true, force-push to default_branch instead of
#                      opening a pull request. Default false (off).
#
# The name is what related-service detection matches in project docs.
# Use the same name the documentation uses for that service.
# Not mixed with GitLab gitlab-projects.conf.

[
  {
    "name": "my-app",
    "path": "/home/ubuntu/dev/my-app",
    "block_on_open_pr": true,
    "default_branch": "main",
    "force_push_to_default": false
  },
  {
    "name": "other-app",
    "path": "/home/ubuntu/dev/other-app",
    "block_on_open_pr": false,
    "force_push_to_default": true
  }
]
