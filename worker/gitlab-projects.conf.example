# GitLab projects for the AI worker.
# Copy to gitlab-projects.conf and edit:
#   cp gitlab-projects.conf.example gitlab-projects.conf
#
# Format: JSON array of objects.
# Required fields: name, path
# Optional fields:
#   block_on_open_pr — if true (default), do not start a new `ai` issue
#                      while this repo has an open MR labeled ai,
#                      ai-working, ai-failed, or ai-pr. Human MRs without
#                      those labels do not block. Set false to allow new
#                      issues even with AI-labeled open MRs.
#                      Exception: ai + no-change (Q&A) may still start.
#                      (ai-working issues and a running agent still block.)
#   default_branch — MR target branch (default main).
#   force_push_to_default — if true, force-push to default_branch instead of
#                      opening a merge request. Default false (off).
#
# The name is what related-service detection matches in project docs.
# Use the same name the documentation uses for that service.
# Not mixed with GitHub github-projects.conf.

[
  {
    "name": "my-service",
    "path": "/home/ubuntu/dev/my-service",
    "block_on_open_pr": true,
    "default_branch": "main",
    "force_push_to_default": false
  },
  {
    "name": "other-service",
    "path": "/home/ubuntu/dev/other-service",
    "block_on_open_pr": false,
    "force_push_to_default": true
  }
]
