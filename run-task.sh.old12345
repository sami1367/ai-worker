#!/usr/bin/env bash

set -euo pipefail

PROJECT="$1"
TASK="$2"

PROJECT_DIR="/home/ubuntu/dev/$PROJECT"

if [ ! -d "$PROJECT_DIR" ]; then
    echo "ERROR: Project not found: $PROJECT"
    exit 1
fi

echo "========================================"
echo "Project: $PROJECT"
echo "Directory: $PROJECT_DIR"
echo "========================================"

cd "$PROJECT_DIR"

# Make sure the repository is clean before starting.
if [ -n "$(git status --porcelain)" ]; then
    echo "ERROR: Git working tree is not clean."
    echo "Please commit/stash existing changes first."
    git status
    exit 1
fi

git fetch origin

BRANCH="ai-$(date +%Y%m%d-%H%M%S)"

echo "Starting Cursor Agent..."
echo "Worktree: $BRANCH"

agent \
    --workspace "$PROJECT_DIR" \
    --worktree "$BRANCH" \
    -p \
"
You are working on the project: $PROJECT

Task:
$TASK

Instructions:

1. First inspect the existing implementation carefully.
2. Understand the architecture before making changes.
3. Implement the requested task.
4. Do not modify the database schema unless explicitly requested.
5. Do not modify production infrastructure unless explicitly requested.
6. Do not expose or print secrets, API keys, passwords, or environment variables.
7. Run the appropriate tests.
8. Run the appropriate lint/format checks.
9. Review your changes.
10. Commit the changes.
11. Push the branch to origin.
12. Create a GitHub pull request against the main branch.

Before finishing, report:

- Summary of changes
- Files changed
- Tests executed
- Lint/format checks
- Any problems encountered
- Commit hash
- Pull request URL
"
