# Copy to .env and fill required values.

# Required — random secret for first admin creation at /setup.
# Example: INITIAL_ADMIN_BOOTSTRAP_SECRET=xK9mP2vL7qR4wN8j
INITIAL_ADMIN_BOOTSTRAP_SECRET=

# Concurrent agents (default 1). Each agent runs one issue/PR/MR; still one task per repo.
# Example: WORKERS=3
WORKERS=1

# GitHub: https://github.com/settings/tokens
# Classic PAT (recommended): scope `repo` (full private repo access — issues, PRs, labels, releases, git push)
# Fine-grained PAT: repository access to needed repos, with Read and write on:
#   Contents, Issues, Pull requests (Metadata is automatic)
GITHUB_TOKEN=

# GitLab: https://gitlab.com/-/user_settings/personal_access_tokens
# Self-managed: https://<host>/-/user_settings/personal_access_tokens
# Required scopes: `api` + `write_repository`
#   api             — issues, MRs, notes, labels, releases, project listing
#   write_repository — git clone/fetch/push over HTTPS
# (`read_api` alone is discovery-only and is not enough for the worker)
GITLAB_HOST=gitlab.com
GITLAB_TOKEN=
