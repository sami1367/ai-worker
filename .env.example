# AI Worker Platform — copy to .env and fill in values.
# Never commit a real .env file.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Published web bind is set in docker-compose (default 127.0.0.1:8080)
APP_BASE_URL=http://127.0.0.1:8080

# PostgreSQL
POSTGRES_USER=aiworker
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aiworker
DATABASE_URL=postgresql://aiworker:change-me-strong-password@db:5432/aiworker

# Auth / crypto (required)
# NUXT_SESSION_PASSWORD must be >= 32 characters
NUXT_SESSION_PASSWORD=replace-with-a-long-random-session-secret-32chars
SESSION_SECRET=replace-with-a-long-random-session-secret-32chars
# 64 hex chars recommended for AES-256-GCM
SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# First-run admin bootstrap (no default password is created automatically)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_BOOTSTRAP_SECRET=replace-with-one-time-bootstrap-secret

# Shared token for worker → web internal API
WORKER_INTERNAL_TOKEN=replace-with-long-random-worker-token

# Worker paths inside containers
AI_WORKER_BASE_DIR=/data/config
WORKSPACE_ROOT=/data/workspaces
LOGS_DIR=/data/logs
STATE_DIR=/data/state
CONFIG_DIR=/data/config
WEB_INTERNAL_URL=http://web:3000
CHECK_INTERVAL=60
HEARTBEAT_INTERVAL=30
TZ=UTC

# Forge credentials (optional env-based fallback; OAuth connections preferred)
# GitHub: use GH_TOKEN or mount gh auth; GITHUB_TOKEN alias supported by some tools
GITHUB_TOKEN=
GH_TOKEN=
GITLAB_HOST=git.example.com
GITLAB_TOKEN=

# GitHub OAuth App (Connections UI)
# Callback: ${APP_BASE_URL}/api/v1/connections/oauth/github/callback
# Requested scopes: repo read:user user:email
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitLab OAuth Application (GitLab.com or self-managed)
# Callback: ${APP_BASE_URL}/api/v1/connections/oauth/gitlab/callback
# Scopes: api read_user read_repository write_repository
# Enable PKCE on the OAuth application when the instance supports it.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Comma-separated hostnames allowed for private/internal GitLab (SSRF allowlist)
GITLAB_TRUSTED_HOSTS=
# Set true only for trusted allowlisted hosts that speak HTTP (local/dev)
GITLAB_ALLOW_HTTP=false

# AI provider defaults (worker process env).
# Prefer connecting keys in the UI (Providers) — they are encrypted and written to
# /data/config/provider-credentials.env for the worker. Compose env remains a fallback.
AI_PROVIDER=cursor
# AI_CURSOR_MODEL=
# CURSOR_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

APP_VERSION=1.0.0
