# Download this file as .env, then run generate-env.sh (the Quick start does both).
# This file has no usable secrets — generate-env.sh fills them in automatically.

# Required secrets — filled by: curl .../scripts/generate-env.sh | bash
# POSTGRES_PASSWORD=
# DATABASE_URL=
# NUXT_SESSION_PASSWORD=
# SECRET_ENCRYPTION_KEY=
# WORKER_INTERNAL_TOKEN=
# INITIAL_ADMIN_BOOTSTRAP_SECRET=

# Public URL (change behind TLS reverse proxy)
# APP_BASE_URL=http://127.0.0.1:8080

# Optional forge / AI provider tokens (or configure in the UI)
# GITHUB_TOKEN=
# GITLAB_HOST=gitlab.com
# GITLAB_TOKEN=
# CURSOR_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# OPENAI_API_KEY=
# CODEX_API_KEY=

# WORKERS=1
# CHECK_INTERVAL=30
# AI_WORKER_IMAGE=sami1367/ai-worker:latest

# AI agent isolation: auto (bwrap if available), bwrap, env, or off (insecure)
# AI_ISOLATION_MODE=auto
# AI_CURSOR_SANDBOX=enabled
# AI_CODEX_SANDBOX=workspace-write

# After the first successful docker compose up, secrets are persisted on the
# data volume at /data/config/app-secrets.env. You may remove the host .env
# if you no longer need environment-based overrides (optional tokens above).
