# Copy to .env and fill in your values:
#   cp .env.example .env

GITLAB_HOST=git.dctm.dev
GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# AI provider — see README "AI providers" section for full setup guide
# ---------------------------------------------------------------------------
# cursor (default) | claude
AI_PROVIDER=cursor

# --- Cursor (AI_PROVIDER=cursor) ---
# Install: agent or cursor-agent on PATH (~/.local/bin or ~/.cursor/bin)
# Non-interactive flags (--force, --trust) are applied in lib/ai/cursor.sh
# AI_CURSOR_MODEL=
# AI_CURSOR_EXTRA_ARGS=

# --- Claude Code (AI_PROVIDER=claude) ---
# Install: curl -fsSL https://claude.ai/install.sh | bash
# Auth (required — pick one):
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=
# AI_CLAUDE_MODEL=claude-sonnet-4-20250514
# AI_CLAUDE_PERMISSION_MODE=acceptEdits
# AI_CLAUDE_REVIEW_PERMISSION_MODE=acceptEdits
# AI_CLAUDE_MAX_TURNS=50
# AI_CLAUDE_ALLOWED_TOOLS=
# AI_CLAUDE_OUTPUT_FORMAT=stream-json
# AI_CLAUDE_EXTRA_ARGS=
