# Copy to .env and fill in your token:
#   cp .env.example .env

GITLAB_HOST=git.dctm.dev
GITLAB_TOKEN=

# AI provider: cursor (default) | claude
# AI_PROVIDER=cursor

# --- Cursor (when AI_PROVIDER=cursor) ---
# Non-interactive flags (--force, --trust) are set in lib/ai/cursor.sh
# AI_CURSOR_MODEL=

# --- Claude Code (when AI_PROVIDER=claude) ---
# Requires: claude on PATH and ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN
# AI_CLAUDE_MODEL=
# AI_CLAUDE_PERMISSION_MODE=acceptEdits
# AI_CLAUDE_REVIEW_PERMISSION_MODE=acceptEdits
